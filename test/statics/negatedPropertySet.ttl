PREFIX : <ex://>

# `:a` reaches `:b` over two predicates outside `{ :r }`, so `:a !:r :b` holds once - not once per predicate.
:a :p :b .
:a :q :b .
# Only over the negated predicate: never an answer to `!:r`.
:a :r :c .
# Two witnesses for the same end point of a sequence, so `:z :s/!:r ?o` keeps the multiplicity of `:s`.
:z :s :a , :a2 .
:a2 :p :b .
