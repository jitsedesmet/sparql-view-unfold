# The CommonJS build needs a package.json marking it as such, since the root package is a module.
# It is committed rather than generated, as the Traqula packages do it.
dist/*
!dist/cjs/
dist/cjs/*
!dist/cjs/package.json
*.ttl
*.nt
!test/statics/*.ttl
.devcontainer/devcontainer.json
*.pdf
# Fuseki's default runtime/config directory when fuseki-server.jar is launched
# from the repo root (e.g. via JenaEngine / test/bench) with no --base override.
/run
bench-*.json
# Benchmark figures are regenerated from the results JSON with `node test/bench/plot.mjs`.
test/bench/results/figures/
